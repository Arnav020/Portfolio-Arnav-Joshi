# Copy to .env and fill in. No secrets live here.

# Formspree form id — the part after /f/ in https://formspree.io/f/xxxxxxx
# Without it, the contact form falls back to opening a mailto: draft.
# NEXT_PUBLIC_* values are inlined at BUILD time, so this must also be set
# in the Vercel project's environment variables for the deployed site.
NEXT_PUBLIC_FORMSPREE_ID=

# Canonical site origin.
NEXT_PUBLIC_SITE_URL=https://arnavjoshi.tech
